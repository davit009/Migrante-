# ==========================================
# Migrante$ — Variables de Entorno
# ==========================================
# Copia este archivo como .env.local y completa los valores

# Supabase (obtener en: https://app.supabase.com -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# API de Tipo de Cambio (sin key para open.er-api.com)
# Usamos open.er-api.com que es completamente gratuita y sin registro
NEXT_PUBLIC_EXCHANGE_API_URL=https://open.er-api.com/v6/latest/USD

# App URL (para OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banxico SIE API (opcional — para la tasa de CETES en vivo del Simulador de Inversión)
# Genera un token gratuito en: https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Si se deja vacío, el simulador usa una tasa de referencia estática claramente marcada como tal.
BANXICO_TOKEN=
